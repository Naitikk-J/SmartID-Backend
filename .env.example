# ═══════════════════════════════════════════════════════════════
# MITS Smart ID — Backend Environment Variables
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
# Environment: development | staging | production
NODE_ENV=development
# Port the API server listens on
PORT=4000

# MongoDB Atlas connection string (Prisma format)
DATABASE_URL="REDACTED"

# ─── Redis (Optional) ─────────────────────────────────────────
# Optional for access QR scanning (stateless tokens). Keep this only if you use Redis-backed caching.
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ──────────────────────────────────────
# Secret key for signing JWTs — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64_minimum_64_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Access token expiry (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h
# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── AES Encryption (QR Code Payloads) ───────────────────────
# 64-char hex string = 32 bytes = AES-256 key
# Generate with: openssl rand -hex 32
# CRITICAL: This MUST match the Flutter app's AES_KEY exactly
AES_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32_gives_64_hex_chars_aaa
# IV length in bytes (always 16 for AES-256-GCM)
AES_IV_LENGTH=16

# ─── AWS S3 (Student Photo Storage) ──────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=REDACTED
AWS_REGION=ap-south-1

# ─── Firebase (Push Notifications) ───────────────────────────
# Path to the Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=REDACTED

# ─── CORS ─────────────────────────────────────────────────────
# Dashboard URL for CORS whitelist (no trailing slash)
DASHBOARD_URL=http://localhost:5173

# ─── Error Monitoring (Optional) ─────────────────────────────
# Sentry DSN for error tracking — leave empty to disable
SENTRY_DSN=

# ─── SMTP Mail (Event Daily Reports) ─────────────────────────
# For Gmail: use smtp.gmail.com with either:
# - TLS STARTTLS: SMTP_PORT=587 and SMTP_SECURE=false
# - SSL/TLS:      SMTP_PORT=465 and SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-mailbox@domain.com
SMTP_PASS=your-app-password
SMTP_FROM=your-mailbox@domain.com
SMTP_SECURE=false

# ─── Access Scan (QR + Geofence) ─────────────────────────────
# Dynamic gate QR validity window in seconds (safe range: 15-120)
ACCESS_QR_TTL_SECONDS=30
# Set true to block scans when geofence is missing for a gate
ACCESS_REQUIRE_GEOFENCE=false
