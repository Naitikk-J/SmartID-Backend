# ═══════════════════════════════════════════════════════════════
# MITS Smart ID — Backend Environment Variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="mongodb://USER:PASSWORD@HOST/DB"

# ─── Redis (optional, used for rate limits + JWT blacklist) ──
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── JWT ─────────────────────────────────────────────────────
# openssl rand -hex 64
JWT_SECRET=<128-hex-chars>
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── AES (QR payload encryption) ─────────────────────────────
# openssl rand -hex 32  — MUST match the Flutter app's AES_KEY
AES_KEY=<64-hex-chars>
AES_IV_LENGTH=16

# ─── AWS S3 (student photo storage) ──────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ─── Firebase (push notifications) ───────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=REDACTED

# ─── Google Sign-In ──────────────────────────────────────────
# Client ID is safe to check in; keep it here for parity with front-end.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# ─── CORS (comma-separated) ──────────────────────────────────
DASHBOARD_URL=http://localhost:5173

# ─── SMTP (event reports + campus-entry credential emails) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MITS Smart ID <no-reply@example.com>"
SMTP_SECURE=false

# ─── Admin console allowlist ─────────────────────────────────
# Comma-separated. Any email not on this list is rejected server-side.
ADMIN_ALLOWED_EMAILS=you@example.com

# ─── Campus Entry ────────────────────────────────────────────
CAMPUS_ENTRY_STUDENT_DOMAIN=mitsgwl.ac.in
CAMPUS_ENTRY_QR_TTL_SECONDS=20
CAMPUS_ENTRY_LOGIN_URL=https://smartid.example.com/student/login
# CAMPUS_ENTRY_EVENT_NAME=MITS Campus Entry
# EVENT_QR_SIGNING_SECRET=<openssl rand -hex 32>

# ─── Error monitoring (optional) ─────────────────────────────
# SENTRY_DSN=
