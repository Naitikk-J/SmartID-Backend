// ═══════════════════════════════════════════════════════════════
// MITS Smart ID — Prisma Schema for MongoDB
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────
enum StudentType {
  DAY_SCHOLAR
  HOSTELLER_BOYS
  HOSTELLER_GIRLS
}

enum CardStatus {
  ACTIVE
  LOST
  INACTIVE
  REPLACED
}

enum PinkSlipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPER_ADMIN
  HOD
  FACULTY
  WARDEN
  SECURITY_GUARD
}

enum AdminModule {
  LIBRARY
  MESS
  CANTEEN
  HEALTH
  FINANCE
  EVENTS
}

enum AttendanceMethod {
  SCAN
  MANUAL_OVERRIDE
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum ExitDirection {
  EXIT
  ENTRY
}

enum ExitMode {
  SINGLE
  UNLIMITED
  CUSTOM
}

enum RebindRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LateReturnStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  REJECTED
}

enum ScanSyncStatus {
  QUEUED
  SYNCED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────

model Student {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentNo    String       @unique
  fullName        String
  fatherName      String?
  email           String       @unique
  phone           String?
  fatherMobile    String?
  department      String
  year            Int          // 1-4
  section         String?
  roomNo          String?
  allottedNo      String?
  category        String?
  permanentAddress String?
  studentType     StudentType
  photoUrl        String?
  bloodGroup      String?
  allergies       String[]     @default([])
  conditions      String[]     @default([])
  emergencyName   String?
  emergencyPhone  String?
  fcmToken        String?
  linkedDeviceId  String?
  linkedDeviceLabel String?
  linkedDevicePlatform String?
  deviceLinkedAt  DateTime?
  lastLoginAt     DateTime?
  lastLogoutAt    DateTime?
  isActive        Boolean      @default(true)
  passwordHash    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cards                Card[]
  attendanceRecords    AttendanceRecord[]
  scanEvents           ScanEvent[]
  exitEvents           ExitEvent[]
  libraryTransactions  LibraryTransaction[]
  votes                Vote[]
  faceData             FaceData?
  faceDetectionLogs    FaceDetectionLog[]
  pinkSlips            PinkSlip[]
  authLogs             StudentAuthLog[]
  deviceRebindRequests DeviceRebindRequest[]
  lateReturnRequests   LateReturnRequest[]
  scanSyncAudits       ScanSyncAudit[]
  eventParticipants    EventParticipant[]
  eventStayScans       EventStayScan[]
  eventMealScans       EventMealScan[]

  @@index([studentType])
  @@map("students")
}

model Card {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String      @db.ObjectId
  cardUid         String      @unique
  qrToken         String      @unique
  status          CardStatus  @default(ACTIVE)
  issuedAt        DateTime    @default(now())
  deactivatedAt   DateTime?
  deactivatedById String?     @db.ObjectId
  notes           String?

  student         Student     @relation(fields: [studentId], references: [id])
  deactivatedBy   AdminUser?  @relation("DeactivatedCards", fields: [deactivatedById], references: [id])
  scanEvents      ScanEvent[]

  @@index([studentId])
  @@map("cards")
}

model AdminUser {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String      @unique
  passwordHash    String
  role            AdminRole
  department      String?
  module          AdminModule?
  isActive        Boolean     @default(true)
  lastLogin       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  scannedEvents       ScanEvent[]
  deactivatedCards    Card[]           @relation("DeactivatedCards")
  exitRulesUpdated    ExitRule[]
  exitOverrides       ExitEvent[]      @relation("ExitOverrides")
  attendanceSessions  AttendanceSession[]
  attendanceOverrides AttendanceRecord[] @relation("AttendanceOverrides")
  subjects            Subject[]
  campusEvents        CampusEvent[]
  auditLogs           AuditLog[]
  approvedPinkSlips   PinkSlip[]       @relation("ApprovedPinkSlips")
  processedRebindRequests DeviceRebindRequest[] @relation("ProcessedRebindRequests")
  acknowledgedLateReturns LateReturnRequest[] @relation("AcknowledgedLateReturns")
  gateId              String?      @db.ObjectId
  gate                Gate?        @relation(fields: [gateId], references: [id])

  @@map("admin_users")
}

model Gate {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  location   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  scanEvents  ScanEvent[]
  exitEvents  ExitEvent[]
  admins      AdminUser[]

  @@map("gates")
}

model ScanEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?  @db.ObjectId
  cardId      String?  @db.ObjectId
  scannedById String   @db.ObjectId
  scanType    String
  result      String
  gpsLat      Float?
  gpsLng      Float?
  gateId      String?  @db.ObjectId
  metadata    Json?
  scannedAt   DateTime @default(now())

  student     Student?  @relation(fields: [studentId], references: [id])
  card        Card?     @relation(fields: [cardId], references: [id])
  scannedBy   AdminUser @relation(fields: [scannedById], references: [id])
  gate        Gate?     @relation(fields: [gateId], references: [id])

  @@index([scannedAt])
  @@index([studentId, scannedAt])
  @@index([scanType, scannedAt])
  @@index([scannedById, scanType, scannedAt])
  @@index([result, scannedAt])
  @@index([gateId, scannedAt])

  @@map("scan_events")
}

model ExitRule {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  studentType StudentType
  dayOfWeek   Int         // 1=Mon ... 7=Sun
  maxExits    Int
  updatedById String?     @db.ObjectId
  updatedAt   DateTime    @default(now()) @updatedAt

  updatedBy   AdminUser?  @relation(fields: [updatedById], references: [id])

  @@unique([studentType, dayOfWeek])
  @@map("exit_rules")
}

model CurfewRule {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  studentType StudentType
  startTime   String      // e.g., "21:00"
  endTime     String      // e.g., "06:00"
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt

  @@map("curfew_rules")
}

model ExitEvent {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String        @db.ObjectId
  gateId       String?       @db.ObjectId
  direction    ExitDirection
  eventDate    DateTime
  eventTime    DateTime      @default(now())
  overrideById String?       @db.ObjectId

  student      Student       @relation(fields: [studentId], references: [id])
  gate         Gate?         @relation(fields: [gateId], references: [id])
  overrideBy   AdminUser?    @relation("ExitOverrides", fields: [overrideById], references: [id])

  @@index([studentId, eventTime])
  @@index([direction, eventTime])
  @@index([gateId, eventTime])
  @@map("exit_events")
}

model CampusEvent {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  isStayHostel Boolean   @default(false)
  hostelGateLabel String?
  reportRecipients String[] @default([])
  timezone    String     @default("Asia/Kolkata")
  importedCount Int      @default(0)
  maxMealsPerParticipant Int?
  eventDate   DateTime
  startTime   DateTime
  endTime     DateTime
  exitMode    ExitMode   @default(SINGLE)
  customMax   Int?
  appliesTo   String[]   @default(["ALL"])
  gateIds     String[]   @default([])
  isActive    Boolean    @default(true)
  createdById String     @db.ObjectId
  createdAt   DateTime   @default(now())

  createdBy   AdminUser  @relation(fields: [createdById], references: [id])
  participants EventParticipant[]
  stayScans   EventStayScan[]
  messRules   EventMessRule[]
  mealScans   EventMealScan[]

  @@map("campus_events")
}

model EventParticipant {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  eventId            String      @db.ObjectId
  studentId          String?     @db.ObjectId
  enrollmentNo       String?
  fullName           String
  email              String
  phone              String
  loginId            String
  passwordHint       String?
  maxMealsAllowed    Int?
  mealsConsumed      Int?
  isActive           Boolean     @default(true)
  credentialsIssuedAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  event              CampusEvent @relation(fields: [eventId], references: [id])
  student            Student?    @relation(fields: [studentId], references: [id])
  stayScans          EventStayScan[]
  mealScans          EventMealScan[]

  @@index([eventId, email])
  @@index([eventId, loginId])
  @@index([studentId])
  @@map("event_participants")
}

model EventStayScan {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  eventId       String            @db.ObjectId
  participantId String?           @db.ObjectId
  studentId     String?           @db.ObjectId
  direction     ExitDirection
  scanMode      String            @default("DYNAMIC_QR")
  gateLabel     String?
  result        String            @default("VERIFIED")
  scannedAt     DateTime          @default(now())
  metadata      Json?

  event         CampusEvent       @relation(fields: [eventId], references: [id])
  participant   EventParticipant? @relation(fields: [participantId], references: [id])
  student       Student?          @relation(fields: [studentId], references: [id])

  @@index([eventId, scannedAt])
  @@index([participantId, scannedAt])
  @@index([studentId, scannedAt])
  @@map("event_stay_scans")
}

model EventMessRule {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  eventId    String       @db.ObjectId
  mealNumber Int
  mealLabel  String
  startTime  String
  endTime    String
  isActive   Boolean      @default(true)
  qrToken    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  event      CampusEvent  @relation(fields: [eventId], references: [id])
  mealScans  EventMealScan[]

  @@unique([eventId, mealNumber])
  @@index([eventId, isActive])
  @@map("event_mess_rules")
}

model EventMealScan {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  eventId       String            @db.ObjectId
  participantId String?           @db.ObjectId
  studentId     String?           @db.ObjectId
  mealRuleId    String?           @db.ObjectId
  mealNumber    Int
  mealLabel     String
  scannedAt     DateTime          @default(now())
  metadata      Json?

  event         CampusEvent       @relation(fields: [eventId], references: [id])
  participant   EventParticipant? @relation(fields: [participantId], references: [id])
  student       Student?          @relation(fields: [studentId], references: [id])
  mealRule      EventMessRule?    @relation(fields: [mealRuleId], references: [id])

  @@index([eventId, scannedAt])
  @@index([participantId, scannedAt])
  @@index([studentId, scannedAt])
  @@index([eventId, mealNumber, scannedAt])
  @@map("event_meal_scans")
}

model Subject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  department  String
  semester    Int
  facultyId   String   @db.ObjectId
  createdAt   DateTime @default(now())

  faculty     AdminUser           @relation(fields: [facultyId], references: [id])
  timetableSlots TimetableSlot[]
  attendanceSessions AttendanceSession[]

  @@map("subjects")
}

model TimetableSlot {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  subjectId       String   @db.ObjectId
  dayOfWeek       Int
  startTime       DateTime
  endTime         DateTime
  room            String?
  gpsLat          Float?
  gpsLng          Float?
  gpsRadiusMetres Int      @default(50)

  subject         Subject  @relation(fields: [subjectId], references: [id])

  @@map("timetable_slots")
}

model AttendanceSession {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  subjectId       String                  @db.ObjectId
  facultyId       String                  @db.ObjectId
  status          AttendanceSessionStatus  @default(OPEN)
  windowMinutes   Int                     @default(15)
  startedAt       DateTime                @default(now())
  closedAt        DateTime?

  subject         Subject                 @relation(fields: [subjectId], references: [id])
  faculty         AdminUser               @relation(fields: [facultyId], references: [id])
  records         AttendanceRecord[]

  @@index([facultyId, status, startedAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  sessionId       String           @db.ObjectId
  studentId       String           @db.ObjectId
  method          AttendanceMethod @default(SCAN)
  gpsLat          Float?
  gpsLng          Float?
  overrideById    String?          @db.ObjectId
  overrideReason  String?
  markedAt        DateTime         @default(now())

  session         AttendanceSession @relation(fields: [sessionId], references: [id])
  student         Student           @relation(fields: [studentId], references: [id])
  overrideBy      AdminUser?        @relation("AttendanceOverrides", fields: [overrideById], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId, markedAt])
  @@index([studentId, markedAt])
  @@map("attendance_records")
}

model Book {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  isbn            String?
  title           String
  author          String
  qrCode          String   @unique
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())

  transactions    LibraryTransaction[]

  @@map("books")
}

model LibraryTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  bookId      String   @db.ObjectId
  issuedAt    DateTime @default(now())
  dueAt       DateTime
  returnedAt  DateTime?
  fineAmount  Float    @default(0)

  student     Student  @relation(fields: [studentId], references: [id])
  book        Book     @relation(fields: [bookId], references: [id])

  @@map("library_transactions")
}

model Election {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  candidates  String[]
  openAt      DateTime
  closeAt     DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  votes       Vote[]

  @@map("elections")
}

model Vote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  electionId  String   @db.ObjectId
  studentId   String   @db.ObjectId
  candidate   String
  votedAt     DateTime @default(now())

  election    Election @relation(fields: [electionId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([electionId, studentId])
  @@map("votes")
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId     String   @db.ObjectId
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  loggedAt    DateTime @default(now())

  actor       AdminUser @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model StudentAuthLog {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String?   @db.ObjectId
  studentEmail     String?
  enrollmentNo     String?
  action           String
  status           String    @default("SUCCESS")
  reason           String?
  deviceId         String?
  deviceLabel      String?
  devicePlatform   String?
  linkedStudentId  String?   @db.ObjectId
  linkedEnrollmentNo String?
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime  @default(now())

  student          Student?  @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([deviceId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("student_auth_logs")
}

model DeviceRebindRequest {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String               @db.ObjectId
  currentDeviceId  String?
  requestedDeviceId String
  requestedLabel   String?
  requestedPlatform String?
  reason           String?
  status           RebindRequestStatus  @default(PENDING)
  requestedAt      DateTime             @default(now())
  processedAt      DateTime?
  processedById    String?              @db.ObjectId
  adminNote        String?

  student          Student              @relation(fields: [studentId], references: [id])
  processedBy      AdminUser?           @relation("ProcessedRebindRequests", fields: [processedById], references: [id])

  @@index([studentId, status, requestedAt])
  @@index([requestedDeviceId, status, requestedAt])
  @@index([status, requestedAt])
  @@map("device_rebind_requests")
}

model FaceData {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String       @unique @db.ObjectId
  faceEmbeddings  Float[]      // Array of 128-dimensional face embeddings (flattened from multiple captures)
  faceImages      String[]     // Base64-encoded face capture images (max 3)
  qualityScore    Float        // Average quality across all captures (0-100)
  enrolledAt      DateTime     @default(now())
  enrolledBy      String?      @db.ObjectId // AdminUser who registered the face
  lastMatchedAt   DateTime?
  matchCount      Int          @default(0)
  isActive        Boolean      @default(true)
  updatedAt       DateTime     @updatedAt

  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("face_data")
}

model FaceDetectionLog {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String       @db.ObjectId
  direction       String       // ENTRY or EXIT
  confidence      Float        // Match confidence percentage (0-100)
  timestamp       DateTime     @default(now())
  source          String?      // Camera or gate ID

  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([studentId, timestamp])
  @@index([direction, timestamp])
  @@index([studentId, direction, timestamp])

  @@map("face_detection_logs")
}

model PinkSlip {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String         @db.ObjectId
  reason       String
  fromDate     DateTime
  toDate       DateTime
  status       PinkSlipStatus @default(PENDING)
  approvedById String?        @db.ObjectId
  remarks      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student      Student        @relation(fields: [studentId], references: [id])
  approvedBy   AdminUser?     @relation("ApprovedPinkSlips", fields: [approvedById], references: [id])

  @@map("pink_slips")
}

model LateReturnRequest {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String           @db.ObjectId
  eta            DateTime
  reason         String
  latitude       Float?
  longitude      Float?
  status         LateReturnStatus @default(PENDING)
  adminNote      String?
  acknowledgedById String?        @db.ObjectId
  requestedAt    DateTime         @default(now())
  processedAt    DateTime?

  student        Student          @relation(fields: [studentId], references: [id])
  acknowledgedBy AdminUser?       @relation("AcknowledgedLateReturns", fields: [acknowledgedById], references: [id])

  @@index([studentId, requestedAt])
  @@index([status, requestedAt])
  @@map("late_return_requests")
}

model ScanSyncAudit {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String         @db.ObjectId
  scanEventId    String?        @db.ObjectId
  status         ScanSyncStatus @default(QUEUED)
  qrTokenHash    String?
  eventType      String?
  gateLabel      String?
  deviceTimestamp DateTime?
  syncedAt       DateTime?
  failureReason  String?
  payload        Json?
  createdAt      DateTime       @default(now())

  student        Student        @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("scan_sync_audits")
}
