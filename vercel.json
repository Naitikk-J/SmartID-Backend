{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/index.js"
        },
        {
            "src": "/health",
            "dest": "api/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.js"
        }
    ],
    "env": {
        "NODE_ENV": "production",
        "DASHBOARD_URL": "http://localhost:5173,https://smart-id-frontend-seven.vercel.app"
    },
    "crons": [
        {
            "path": "/api/v1/events/reports/cron/send-daily",
            "schedule": "30 14 * * *"
        }
    ]
}